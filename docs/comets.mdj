              "ownedElements": [
                {
                  "_type": "UMLUseCase",
                  "_id": "kUF6ZdC3MdN0X9danVn35v8u",
                  "_parent": {
                    "$ref": "OimFcJ+VV7iQZWynWMwFwxSe"
                  },
                  "name": "Войти в систему",
                  "documentation": "Страница «Вход» (/login). POST /api/users/login. После входа астроном переходит в ленту."
                },
                {
                  "_type": "UMLUseCase",
                  "_id": "3wkNHtzqF843WApQQy/Ea3PZ",
                  "_parent": {
                    "$ref": "OimFcJ+VV7iQZWynWMwFwxSe"
                  },
                  "name": "Посмотреть ленту",
                  "documentation": "GET /api/comets/feed или GET /api/comets/feed/{id}?next=true. Можно посмотреть сведения о комете, раскрыть описание и перейти к следующей опубликованной комете. При недоступности веб-сервиса используется демо-каталог."
                },
                {
                  "_type": "UMLUseCase",
                  "_id": "vZdshyWBGHXjFA1PtfMfzbBS",
                  "_parent": {
                    "$ref": "OimFcJ+VV7iQZWynWMwFwxSe"
                  },
                  "name": "Посмотреть плитку",
                  "documentation": "GET /api/comets. Нажатие на карточку открывает комету в ленте. При недоступности веб-сервиса используется демо-каталог."
                },
                {
                  "_type": "UMLUseCase",
                  "_id": "6r2mIR2f9EIFu6iZL9xJd7YK",
                  "_parent": {
                    "$ref": "OimFcJ+VV7iQZWynWMwFwxSe"
                  },
                  "name": "Фильтр по периоду",
                  "documentation": "На странице «Плитка» можно задать диапазон периода и применить или сбросить фильтр. Границы передаются как min_orbital_period и max_orbital_period в GET /api/comets.",
                  "ownedElements": [
                    {
                      "_type": "UMLExtend",
                      "_id": "CbsyU02C/MYb5WzBW5VVO4ur",
                      "_parent": {
                        "$ref": "6r2mIR2f9EIFu6iZL9xJd7YK"
                      },
                      "documentation": "При выборе диапазона периода обращения на странице «Плитка».",
                      "source": {
                        "$ref": "6r2mIR2f9EIFu6iZL9xJd7YK"
                      },
                      "target": {
                        "$ref": "vZdshyWBGHXjFA1PtfMfzbBS"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "_type": "UMLPackage",
              "_id": "hoaz4GwO3UpkQ0H6U+xCj0A/",
              "_parent": {
                "$ref": "PyBg698IRBVBOOVE2yM3lnSZ"
              },
              "name": "Интерфейс астронома",
              "ownedElements": [
                {
                  "_type": "UMLUseCase",
                  "_id": "4cEFeASsxpTlw76RrqZHXBDC",
                  "_parent": {
                    "$ref": "hoaz4GwO3UpkQ0H6U+xCj0A/"
                  },
                  "name": "Поставить/снять лайк",
                  "documentation": "Кнопка в ленте. POST /api/comets/{id}/like с like: 1 или 0. Требуется вход, действие недоступно в демо-режиме."
                },
                {
                  "_type": "UMLUseCase",
                  "_id": "vpnRgdz2jypY+mg++oOqMSPe",
                  "_parent": {
                    "$ref": "hoaz4GwO3UpkQ0H6U+xCj0A/"
                  },
                  "name": "Удалить свою комету",
                  "documentation": "Кнопка на карточке своей кометы в плитке. DELETE /api/comets/{id} переводит комету в статус deleted. Действие недоступно в демо-режиме."
                },
                {
                  "_type": "UMLUseCase",
                  "_id": "CU2DuacHM6rQvYHFVMBm2gdD",
                  "_parent": {
                    "$ref": "hoaz4GwO3UpkQ0H6U+xCj0A/"
                  },
                  "name": "Опубликовать комету",
                  "documentation": "На странице «Добавление» астроном заполняет форму и нажимает «Опубликовать». После подготовки черновика PUT /api/comets/{id}/publish сохраняет описание, период обращения и эксцентриситет. Опубликованная комета открывается в ленте.",
                  "ownedElements": [
                    {
                      "_type": "UMLInclude",
                      "_id": "RXhXe+euQQ9W9SPcHqtPYIDd",
                      "_parent": {
